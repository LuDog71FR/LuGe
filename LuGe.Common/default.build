<?xml version="1.0"?>
<project name="LuGe" 
         default="all" 
         basedir="." 
         xmlns="http://nant.sf.net/release/0.85-rc3/nant.xsd">
	
	<!-- Do all -->
	<target name="all" depends="deploy" />

	<!-- Deploy binaries to References folder -->
	<target name="deploy">
		<copy todir="..\..\References" overwrite="true" verbose="true">
			<fileset basedir="LuGe.Common.Forms\bin\Debug">
				<include name="LuGe.Common*.dll" />
				<include name="LuGe.Common*.xml" />
			</fileset>
		</copy>
			
		<copy todir="..\..\References" overwrite="true" verbose="true">
			<fileset basedir="LuGe.Common.Data.SqlObject\bin\Debug">
				<include name="LuGe.Common.Data*.dll" />
				<include name="LuGe.Common.Data*.xml" />
			</fileset>
		</copy>
	</target>
	
</project>
